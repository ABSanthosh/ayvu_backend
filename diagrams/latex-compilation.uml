@startuml latex-compilation
!theme blueprint
title LaTeX to HTML Compilation Workflow

start

:compileLatex() called;
:Create HTML directory;
:Change to latex directory;

partition "File Discovery" {
  fork
    :findTexFile();
    note right
      **Priority Patterns:**
      • main.tex
      • paper.tex
      • manuscript.tex
      • article.tex
      
      **Strategy:**
      1. Priority pattern matching
      2. Search for \documentclass
      3. Use first .tex file
    end note
  fork again
    :findStyFiles();
    note right : Locate custom\nstyle files
  fork again
    :findLtxmlFiles();
    note right : Find LaTeXML\nconfig files
  end fork
}

if (Main .tex found?) then (yes)
  :Build LaTeXML arguments;
  
  partition "LaTeXML Configuration" {
    :Add format options\n--format=html5;
    :Add navigation options\n--navigationtoc=context;
    :Add style options\n--includestyles;
    :Add preloaded packages;
    note right
      **Preloaded Packages:**
      • LaTeX.pool
      • article.cls
      • amsmath.sty
      • graphicx.sty
      • hyperref.sty
      • natbib.sty
      • booktabs.sty
    end note
  }
  
  :Progress Update\nCOMPILE_LATEX\nIN_PROGRESS;
  :Execute latexmlc;
  
  if (Exit code == 0?) then (yes)
    :HTML Generated\npaper.html;
    :Progress Update\nCOMPILE_LATEX\nCOMPLETED;
  else (no)
    :Throw Error\nCompilation Failed;
    stop
  endif
else (no)
  :Throw Error\nNo .tex file found;
  stop
endif

:Change back to root directory;

stop

note bottom
  **LaTeXML Features:**
  • HTML5 output format
  • Context-aware TOC navigation
  • Custom engrafo.ltxml configuration
  • Comprehensive package support
  • Academic paper optimization
end note

@enduml